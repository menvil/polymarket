# Node environment (development, test, production)
NODE_ENV=development

# Polygon blockchain settings
POLYGON_RPC_URL=https://polygon-rpc.com

# Trading credentials (REQUIRED for live trading)
PRIVATE_KEY=
FUNDER_ADDRESS=

#Polymarket api credentials (REQUIRED for live trading)
POLYMARKET_API_KEY=019b5bb3-fb0e-7b82-897f-f8b0135d0f12
POLYMARKET_API_SECRET=L-VjT8weg_KHTYkU1gPqCXGpgk8VuZ0mtizM8KObMV0=
POLYMARKET_API_PASSPHRASE=c72eb0fad6f390d26d5e322baeebb084bce0ddcc0893d58efdad23dbd991b6bc

# Live trading safety settings
LIVE_SAFE_MODE=1
LIVE_CLEAN_START=1

# Logging
LOG_LEVEL=INFO
HEADLESS=1

# ========================================
# Risk Management Configuration
# ========================================
# These settings control the bot's risk management behavior.
# All values can be adjusted without code changes.

# Maximum net position (absolute value of YES - NO)
# When exceeded, bot enters INVENTORY mode to reduce exposure
# Default: 1000
RISK_MAX_NET_POSITION=1000

# Maximum gross position (YES + NO)
# Total position size limit across all sides
# Default: 2000
RISK_MAX_GROSS_POSITION=2000

# Panic mode threshold (0-1)
# When urgency >= this value, bot stops quoting and closes positions aggressively
# Example: 0.8 = 80% urgency triggers PANIC mode
# Default: 0.8
RISK_PANIC_THRESHOLD=0.8

# Inventory mode threshold (0-1)
# When urgency >= this value, bot starts active inventory management
# Example: 0.5 = 50% urgency triggers INVENTORY mode
# Default: 0.5
RISK_INVENTORY_THRESHOLD=0.5

# Time urgency period in seconds
# Urgency grows linearly from 0% to 100% during this period before expiry
# Formula: timeUrgency = 1 - (secondsToExpiry / RISK_TIME_URGENCY_SECONDS)
# Examples:
#   86400 = 24 hours (default) - gradual urgency increase over last day
#   43200 = 12 hours - more aggressive, starts urgency 12h before expiry
#   3600 = 1 hour - very aggressive, only last hour matters
#   2200 = ~37 minutes - for testing
# Default: 86400
RISK_TIME_URGENCY_SECONDS=86400

# ========================================
# Market Rotation Configuration
# ========================================
# Controls automatic market scanning and switching

# Pause between market scans (ms)
# After finishing a scan, wait this long before starting the next one
# Default: 30000 (30 seconds)
MARKET_SCAN_PAUSE_MS=30000

# Market expiry check interval (ms)
# How often to check if the current market has expired
# Default: 1000 (1 second)
MARKET_EXPIRY_CHECK_INTERVAL_MS=1000

# ========================================
# Market Discovery Configuration
# ========================================
# Controls how markets are filtered and selected

# Minimum hours until market expiry
# Markets expiring sooner than this will be filtered out
# 0 = any market including closest to expiry
# Default: 0
MARKET_DISCOVERY_MIN_TIME_TO_EXPIRY_HOURS=0

# Minimum spread (0-1)
# Markets with smaller spread will be filtered out
# Example: 0.02 = 2% minimum spread
# Default: 0.02
MARKET_DISCOVERY_MIN_SPREAD=0.02

# Minimum daily volume (USD)
# Markets with lower volume will be filtered out
# Default: 100
MARKET_DISCOVERY_MIN_DAILY_VOLUME=100

# Required keywords (comma-separated, case-insensitive)
# ALL of these words must be present in market question
# Empty string = no required keywords
# Default: up,down
MARKET_DISCOVERY_REQUIRED_KEYWORDS=up,down

# Any-of keywords (comma-separated, case-insensitive)
# AT LEAST ONE of these words must be present in market question
# Empty string = no filter by keywords
# Default: bitcoin,ethereum,solana,xrp
MARKET_DISCOVERY_ANY_OF_KEYWORDS=bitcoin,ethereum,solana,xrp

# ========================================
# Multi-Market Trading Configuration
# ========================================
# Controls simultaneous trading on multiple markets

# Maximum concurrent markets to trade
# 0 = subscribe to ALL markets passing filters
# N > 0 = subscribe to at most N markets
# If available markets < N, subscribe to all available
# Default: 5
MAX_CONCURRENT_MARKETS=5

# Fraction of total balance available for trading
# Value: (0.0, 1.0]
# Example: 0.8 = use 80% of balance for trading, keep 20% as reserve
# Default: 1.0 (use all balance)
TRADING_BALANCE_RATIO=1.0

# Minimum capital required per market (USDC)
# If per-market balance < this value, reduce number of markets
# Example: With 50 USDC and MIN_CAPITAL_PER_MARKET=10, max 5 markets
# Default: 10
MIN_CAPITAL_PER_MARKET=10

# Trading fee percentage for arbitrage calculations
# Used by ArbitrageDetector to calculate real profit after fees
# Polymarket fee is approximately 0.2%
# Default: 0.2
TRADING_FEE_PERCENT=0.2

# ========================================
# Trade Flow / Fragility Configuration
# ========================================
# Controls trade flow analysis and market fragility detection
# Used by TradeFlowAnalyzer for event-driven market state analysis

# Number of orderbook levels for book imbalance calculation
# More levels = more stable signal, but slower reaction
# Default: 2
TRADE_FLOW_BOOK_LEVELS=2

# Minimum book imbalance for directional signal (0-1)
# Lower = more sensitive, higher = requires stronger imbalance
# Default: 0.2
TRADE_FLOW_BOOK_MIN_THRESHOLD=0.2

# Minimum aggressive volume for fragility calculation
# Trades smaller than this are ignored
# Default: 5
TRADE_FLOW_MIN_AGGRESSIVE_VOLUME=5

# Fragility scaling factor
# Higher = more sensitive fragility score
# Default: 5
TRADE_FLOW_FRAGILITY_SCALE=5

# Decay lambda for exponential decay
# Formula: x_new = x_old × exp(-λ × dt)
# Higher = faster decay (shorter memory)
# Default: 0.002
TRADE_FLOW_DECAY_LAMBDA=0.002

# Time-to-fill thresholds (ms)
# Fast: Strong signal amplification (score = 1.0)
# Medium: Moderate amplification (score = 0.7)
# Slow: Weak signal (score = 0.3)
# Default: 200, 500, 1000
TRADE_FLOW_TIME_TO_FILL_FAST=200
TRADE_FLOW_TIME_TO_FILL_MEDIUM=500
TRADE_FLOW_TIME_TO_FILL_SLOW=1000

# ========================================
# Orderbook Health Configuration
# ========================================
# Controls orderbook health monitoring for EdgeAliveEvaluator
# Used by OrderbookHealthMonitor

# Minimum healthy depth for orderbook
# If bid or ask depth falls below this, orderbook is "thinning"
# Default: 20
ORDERBOOK_HEALTH_MIN_DEPTH=20

# EMA alpha for refill rates calculation (0-1)
# Higher = faster reaction to changes
# Formula: refillRate = α × normalized + (1-α) × previous
# Default: 0.1
ORDERBOOK_HEALTH_EMA_ALPHA=0.1

# EMA alpha for absolute refill baseline (0-1)
# Slower than emaAlpha for more stable normalization
# Formula: baseline = α × absRefillRaw + (1-α) × baseline_prev
# Default: 0.05
ORDERBOOK_HEALTH_BASELINE_ALPHA=0.05

# Maximum bound for absoluteRefillRate (clipping)
# absRefillRate is clipped to [0, absMaxBound]
# Default: 3
ORDERBOOK_HEALTH_ABS_MAX_BOUND=3

# Maximum bound for relativeRefillRate (clipping)
# relativeRefillRate is clipped to [0, relMaxBound]
# Default: 1.5
ORDERBOOK_HEALTH_REL_MAX_BOUND=1.5

# Summary logging interval (ms)
# How often to log orderbook health summary
# Default: 10000 (10 seconds)
ORDERBOOK_HEALTH_SUMMARY_INTERVAL_MS=10000

# ========================================
# Edge Alive Configuration (Layer 0)
# ========================================
# Controls edge liveness detection and state machine
# Used by EdgeAliveEvaluator to determine if market making should continue

# Minimum fragility score for alive edge (0-1)
# If fragilityScore < this value, edge is considered inactive
# Default: 0.1
EDGE_ALIVE_MIN_FRAGILITY_SCORE=0.1

# Minimum orderbook refill rate (0-1)
# If refillRate < this value, liquidity is draining
# Default: 0.3
EDGE_ALIVE_MIN_REFILL_RATE=0.3

# Minimum minutes to expiry for market making
# If timeToExpiry < this value, edge is considered dead
# Default: 4
EDGE_ALIVE_MIN_TIME_TO_EXPIRY_MIN=4

# Warmup period in milliseconds
# During warmup, edge death is reversible
# After warmup, death becomes irreversible
# Default: 90000 (90 seconds)
EDGE_ALIVE_WARMUP_MS=90000

# Bad streak threshold for death
# Number of bad evaluations to transition to DEAD state
# With decay this is an effective value
# Default: 4
EDGE_ALIVE_BAD_STREAK_TO_DEAD=4

# Good streak threshold for revival
# Number of good evaluations to recover from WARNING
# Default: 2
EDGE_ALIVE_GOOD_STREAK_TO_REVIVE=2

# Decay alpha for streaks (0-1)
# Formula: streak = streak × alpha + (isGood ? 1 : 0)
# Higher = slower decay (longer memory)
# Default: 0.8
EDGE_ALIVE_STREAK_DECAY_ALPHA=0.8

# ========================================
# Strategy: Quote Generation
# ========================================
# Core parameters for market making quotes

# Base spread percentage
# Default: 0.02 (2%)
STRATEGY_BASE_SPREAD=0.02

# Quote size in USDC per side
# Default: 100
STRATEGY_QUOTE_SIZE=100

# Minimum spread floor
# Default: 0.005 (0.5%)
STRATEGY_MIN_SPREAD=0.005

# Maximum spread cap
# Default: 0.20 (20%)
STRATEGY_MAX_SPREAD=0.20

# Minimum spread for quote validation
# Default: 0.01 (1%)
STRATEGY_VALIDATION_MIN_SPREAD=0.01

# Price adjustment when crossing orderbook
# Default: 0.001
STRATEGY_PRICE_CROSS_ADJUSTMENT=0.001

# Inventory sensitivity (price adjustment per 100% skew)
# Default: 0.01 (1%)
STRATEGY_INVENTORY_SENSITIVITY=0.01

# Maximum linear skew for quote adjustment
# Default: 0.5 (50%)
STRATEGY_MAX_SKEW=0.5

# Spread multiplier in INVENTORY mode
# Default: 1.5 (50% wider spread)
STRATEGY_INVENTORY_SPREAD_MULTIPLIER=1.5

# Risk spread coefficient (utilization impact on spread)
# Formula: spread *= 1 + (utilization * coefficient)
# Default: 0.5
STRATEGY_RISK_SPREAD_COEFFICIENT=0.5

# ========================================
# Strategy: Non-Linear Skew
# ========================================
# Controls aggressive inventory reduction

# Exponent for non-linear skew
# Formula: |position/maxPosition|^exponent
# Higher = more aggressive at high inventory
# Default: 2.5
STRATEGY_SKEW_EXPONENT=2.5

# Base factor for non-linear skew
# Default: 0.05 (5%)
STRATEGY_SKEW_BASE_FACTOR=0.05

# Maximum skew value cap
# Default: 0.20 (20%)
STRATEGY_MAX_SKEW_VALUE=0.20

# Urgent hours threshold for skew time pressure
# Below this: maximum time pressure
# Default: 0.5 (30 minutes)
STRATEGY_SKEW_URGENT_HOURS=0.5

# Moderate hours threshold for skew time pressure
# Above this: no time pressure
# Default: 2.0 (2 hours)
STRATEGY_SKEW_MODERATE_HOURS=2.0

# Maximum time pressure multiplier for skew
# Default: 5.0
STRATEGY_SKEW_MAX_TIME_MULTIPLIER=5.0

# Time multiplier range (max - 1)
# Used in linear interpolation
# Default: 4.0
STRATEGY_SKEW_TIME_MULTIPLIER_RANGE=4.0

# ========================================
# Strategy: Recovery Mode
# ========================================
# Controls position closing behavior

# Base spread crossing in RECOVERY mode
# Default: 0.01 (1%)
STRATEGY_RECOVERY_BASE_CROSSING=0.01

# Default recovery urgency (when not time-based)
# Default: 0.5
STRATEGY_RECOVERY_DEFAULT_URGENCY=0.5

# Urgent hours threshold for recovery
# Below this: maximum urgency (1.0)
# Default: 0.5 (30 minutes)
STRATEGY_RECOVERY_URGENT_HOURS=0.5

# Moderate hours threshold for recovery
# Default: 2.0 (2 hours)
STRATEGY_RECOVERY_MODERATE_HOURS=2.0

# Fragility boost factor for recovery
# Higher fragility = more aggressive recovery
# Formula: boost = fragilityScore * factor
# Default: 0.01
STRATEGY_FRAGILITY_BOOST_FACTOR=0.01

# Urgency crossing factor for recovery
# Formula: crossing += urgency * factor
# Default: 0.02
STRATEGY_URGENCY_CROSSING_FACTOR=0.02

# ========================================
# Strategy: Panic Mode
# ========================================
# Emergency position closing

# Maximum spread crossing in PANIC mode
# Default: 0.03 (3%)
STRATEGY_PANIC_MAX_CROSSING=0.03

# ========================================
# Strategy: Fair Value Calculation
# ========================================
# Weights must sum to 1.0

# Weight for mid-price in fair value calculation
# Default: 0.5
FAIR_VALUE_WEIGHT_MID=0.5

# Weight for microprice in fair value calculation
# Default: 0.3
FAIR_VALUE_WEIGHT_MICROPRICE=0.3

# Weight for EMA in fair value calculation
# Default: 0.2
FAIR_VALUE_WEIGHT_EMA=0.2

# EMA alpha (smoothing factor)
# Higher = faster reaction to price changes
# Default: 0.1
FAIR_VALUE_EMA_ALPHA=0.1

# ========================================
# Position Management
# ========================================
# Thresholds for position classification

# Threshold for NEUTRAL position classification
# |imbalance| < threshold = NEUTRAL
# Default: 0.1
POSITION_NEUTRAL_THRESHOLD=0.1

# Hedge quality thresholds
# Used by HedgeRatioCalculator
HEDGE_PERFECT_THRESHOLD=0.95
HEDGE_GOOD_THRESHOLD=0.80
HEDGE_MODERATE_THRESHOLD=0.50
HEDGE_POOR_THRESHOLD=0.20

# Minimum acceptable hedge ratio
# Default: 0.8
HEDGE_MIN_ACCEPTABLE=0.8

# Threshold for isHedged check
# Default: 0.9
HEDGE_IS_HEDGED_THRESHOLD=0.9

# ========================================
# Execution
# ========================================
# Order execution parameters

# Maximum acceptable slippage percent
# Default: 1.0
EXECUTION_MAX_SLIPPAGE_PERCENT=1.0

# ========================================
# Risk Utilization Thresholds
# ========================================
# Used by RiskExposure for status classification

# Critical utilization threshold
# Above this = CRITICAL status
# Default: 0.9 (90%)
RISK_CRITICAL_UTILIZATION=0.9

# High utilization threshold
# Above this = HIGH status
# Default: 0.8 (80%)
RISK_HIGH_UTILIZATION=0.8

# ========================================
# Data Collection Configuration
# ========================================
# Controls raw market data collection for analysis and backtests
# Data is saved to files and can be used for offline analysis

# Enable/disable data collection
# 1 = enabled, 0 = disabled
# Can run parallel to trading or standalone (npm run collect)
# Default: 0 (disabled)
DATA_COLLECTION_ENABLED=0

# Output directory for data files
# Creates subdirectories by date: ./snapshots/YYYY-MM-DD/
# Files: {question}___{slug}.{format}[.gz]
# Default: ./snapshots
DATA_COLLECTION_OUTPUT_DIR=./snapshots

# Data format for serialization
# Options:
#   ndjson - JSON Lines (one JSON per line, streaming friendly)
#   parquet - Apache Parquet (columnar, efficient for analysis)
#   arrow - Apache Arrow (in-memory columnar format)
# Default: ndjson
DATA_COLLECTION_FORMAT=ndjson

# Compression type (applied on market expiry)
# Options:
#   none - no compression
#   gzip - gzip compression (creates .gz file)
# Default: none
DATA_COLLECTION_COMPRESSION=none

# Buffer size in number of events
# Events are buffered before writing to disk
# Flush occurs at bufferSize OR flushInterval (whichever first)
# Higher = less I/O, but more data loss on crash
# Default: 100
DATA_COLLECTION_BUFFER_SIZE=100

# Flush interval in milliseconds
# Maximum time between flushes to disk
# Default: 10000 (10 seconds)
DATA_COLLECTION_FLUSH_INTERVAL_MS=10000

# ========================================
# Bucketizer Configuration
# ========================================

# Input directory for snapshots
# Root directory containing YYYY-MM-DD/ folders with .jsonl(.gz) files
# Default: ./snapshots
BUCKET_INPUT_DIR=./snapshots

# Output directory for buckets
# Root directory for bucket output files
# Structure: <bucket_type>/tokenName_side_level_volMin_volMax.jsonl
# Default: ./buckets
BUCKET_OUTPUT_DIR=./buckets

# Bucket types to calculate (comma-separated)
# Default: volume_level_probability_fill
BUCKET_TYPES=volume_level_probability_fill

# Maximum orderbook levels to process
# Default: 10
BUCKET_MAX_LEVELS=10

# Volume bin step size
# Default: 100
BUCKET_VOLUME_STEP=100

# Minimum cumulative volume filter
# Attempts with cumVolume < this value are not created
# Default: 0
BUCKET_VOLUME_MIN=0

# Maximum cumulative volume filter
# Attempts with cumVolume > this value are not created
# Default: 10000
BUCKET_VOLUME_MAX=10000

# Remaining quantity for fill tracking
# Default: 1
BUCKET_REMAINING_QTY=1

# Fill horizons in seconds (comma-separated)
# Default: 5,10,15,30,60,120
BUCKET_HORIZONS_SEC=5,10,15,30,60,120

# Replay mode
# Options:
#   MAX - no delays, maximum speed
#   SCALED - proportional delays (event_delta * scale)
# Default: MAX
REPLAY_MODE=MAX

# Replay scale factor (for SCALED mode only)
# Example: 0.01 = 100x speedup
# Default: 0.01
REPLAY_SCALE=0.01

# Maximum catch-up delay in milliseconds (for SCALED mode)
# Default: 200
REPLAY_MAX_CATCHUP_DELAY_MS=200

# Optional date filters (YYYY-MM-DD format)
# Process snapshots from this date (inclusive)
# BUCKET_FROM_DAY=2026-01-01
# Process snapshots until this date (inclusive)
# BUCKET_TO_DAY=2026-01-05

# ========================================
# Client Implementation Configuration
# ========================================
# Controls which REST and WebSocket client implementations to use

# REST client selection
# "custom" = Our custom PolymarketRestAdapter (polymarket/rest/)
# "official" = Official Polymarket SDK client (@polymarket/clob-client)
# Default: custom
REST_CLIENT_TYPE=custom

# WebSocket client selection
# "custom" = Our custom PolymarketWebSocketManager (polymarket/ws/)
# "official" = Official Polymarket SDK WebSocket client
# Default: custom
WS_CLIENT_TYPE=custom

# ========================================
# Smoke Tests Configuration
# ========================================
# Smoke tests run on REAL exchange with REAL money!
# Should NEVER be included in regular test runs
# Market discovery will automatically find Bitcoin markets for testing
