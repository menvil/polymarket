{
  "name": "@polymarket/market-state",
  "version": "0.1.0",
  "description": "Application-layer state accumulators for market data (book depth, trade tape)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@polymarket/logger": "0.1.0",
    "@polymarket/ids": "0.1.0",
    "@polymarket/value-objects": "0.1.0",
    "@polymarket/ports": "0.1.0",
    "@polymarket/event-bus": "0.1.0",
    "@polymarket/order-book": "0.1.0",
    "@polymarket/trade-tape": "0.1.0",
    "@polymarket/trade": "0.1.0",
    "@polymarket/rolling-window": "0.1.0",
    "@polymarket/result": "0.1.0",
    "@polymarket/errors": "0.1.0",
    "@polymarket/time": "0.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
