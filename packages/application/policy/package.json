{
  "name": "@polymarket/policy",
  "version": "0.1.0",
  "description": "Application-layer owner policy: which of the technically available markets a consumer wants",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:tests": "eslint __tests__ --ext .ts",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc \"docs/*.md\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "policy",
    "market-selection",
    "application-layer"
  ],
  "author": "Ivan Moroz",
  "license": "UNLICENSED",
  "dependencies": {
    "@polymarket/errors": "0.1.0",
    "@polymarket/ids": "0.1.0",
    "@polymarket/market": "0.1.0",
    "@polymarket/ports": "0.1.0",
    "@polymarket/timestamp": "0.1.0",
    "@polymarket/value-objects": "0.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@polymarket/market-discovery": "0.1.0",
    "@polymarket/time": "0.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "decimal.js": "^10.6.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
