{
  "name": "@polymarket/ids",
  "version": "0.1.0",
  "description": "Foundation ID types for Polymarket domain",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./market-data": {
      "types": "./dist/market-data/index.d.ts",
      "import": "./dist/market-data/index.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:dist": "node __tests__/dist-runtime.mjs",
    "test:all": "npm test && npm run test:dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "polymarket",
    "ids",
    "types",
    "foundation"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@polymarket/errors": "workspace:*",
    "@polymarket/result": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  }
}
