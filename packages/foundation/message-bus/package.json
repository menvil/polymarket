{
  "name": "@polymarket/message-bus",
  "version": "0.1.0",
  "description": "Generic in-process typed message delivery primitive - FIFO queue, parallel fan-out, Result-based operational errors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "npm run typecheck:tests && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:tests": "eslint __tests__ --ext .ts",
    "lint:tests:fix": "eslint __tests__ --ext .ts --fix",
    "lint:all": "eslint src __tests__ --ext .ts",
    "lint:all:fix": "eslint src __tests__ --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.lint.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "ci": "npm run typecheck:all && npm test",
    "lint:md": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc \"README.md\" \"docs/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc --fix \"README.md\" \"docs/*.md\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "message-bus",
    "queue",
    "fifo",
    "fan-out",
    "typed",
    "foundation",
    "polymarket"
  ],
  "author": "Ivan Moroz",
  "license": "MIT",
  "dependencies": {
    "@polymarket/messages": "0.1.0",
    "@polymarket/result": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/jest": "^29.5.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "@jest/globals": "^29.7.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
