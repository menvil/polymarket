{
  "name": "@polymarket/math",
  "version": "0.1.0",
  "description": "Pure mathematical operations with Decimal.js for Polymarket trading system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./decimal": {
      "types": "./dist/decimal/index.d.ts",
      "import": "./dist/decimal/index.js"
    },
    "./rounding": {
      "types": "./dist/rounding/index.d.ts",
      "import": "./dist/rounding/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest && npm run test:exports",
    "test:unit": "jest",
    "pretest:exports": "npm run build",
    "test:exports": "node __tests__/integration/verify-package-exports.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:tests": "eslint __tests__ --ext .ts",
    "lint:tests:fix": "eslint __tests__ --ext .ts --fix",
    "lint:all": "eslint src __tests__ --ext .ts",
    "lint:all:fix": "eslint src __tests__ --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.lint.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "lint:md": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc \"docs/**/*.md\" \"README.md\"",
    "lint:md:fix": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc --fix \"docs/**/*.md\" \"README.md\"",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "keywords": [
    "math",
    "decimal",
    "precision",
    "arithmetic",
    "rounding",
    "trading",
    "polymarket",
    "foundation"
  ],
  "author": "Ivan Moroz",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@polymarket/errors": "^0.1.0",
    "decimal.js": "^10.6.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
