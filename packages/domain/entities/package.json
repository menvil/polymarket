{
  "name": "@polymarket/entities",
  "version": "0.1.0",
  "description": "Domain entities for Polymarket trading bot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
