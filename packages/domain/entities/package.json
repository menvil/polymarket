    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polymarket/result": "^0.1.0",
    "@polymarket/errors": "^0.1.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "eslint": "^8.57.0"
  }
}