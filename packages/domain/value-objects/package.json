{
  "name": "@polymarket/value-objects",
  "version": "0.1.0",
  "description": "Domain value objects for Polymarket trading system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./asset-quantity": {
      "types": "./dist/asset-quantity/index.d.ts",
      "import": "./dist/asset-quantity/index.js"
    },
    "./balance": {
      "types": "./dist/balance/index.d.ts",
      "import": "./dist/balance/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.js"
    },
    "./outcome-token": {
      "types": "./dist/outcome-token/index.d.ts",
      "import": "./dist/outcome-token/index.js"
    },
    "./price": {
      "types": "./dist/price/index.d.ts",
      "import": "./dist/price/index.js"
    },
    "./quantity": {
      "types": "./dist/quantity/index.d.ts",
      "import": "./dist/quantity/index.js"
    },
    "./quote": {
      "types": "./dist/quote/index.d.ts",
      "import": "./dist/quote/index.js"
    },
    "./ratio": {
      "types": "./dist/ratio/index.d.ts",
      "import": "./dist/ratio/index.js"
    },
    "./spread": {
      "types": "./dist/spread/index.d.ts",
      "import": "./dist/spread/index.js"
    },
    "./token-balance": {
      "types": "./dist/token-balance/index.d.ts",
      "import": "./dist/token-balance/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:money": "jest --coverage --testPathPattern=money --collectCoverageFrom='src/money/**/*.ts' --collectCoverageFrom='!src/money/**/index.ts'",
    "test:smoke": "node __tests__/smoke/money-package-import.mjs",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:tests": "eslint __tests__ --ext .ts",
    "lint:tests:fix": "eslint __tests__ --ext .ts --fix",
    "lint:all": "eslint src __tests__ --ext .ts",
    "lint:all:fix": "eslint src __tests__ --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.lint.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "ci": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:smoke",
    "ci:full": "npm run typecheck:all && npm run lint:all && npm run build && npm run test:coverage && npm run test:smoke",
    "lint:md": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc \"docs/**/*.md\" \"README.md\"",
    "lint:md:fix": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc --fix \"docs/**/*.md\" \"README.md\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "value-objects",
    "domain-driven-design",
    "ddd",
    "trading",
    "polymarket",
    "domain"
  ],
  "author": "Ivan Moroz",
  "license": "MIT",
  "dependencies": {
    "@polymarket/errors": "^0.1.0",
    "@polymarket/ids": "^0.1.0",
    "@polymarket/math": "^0.1.0",
    "@polymarket/result": "^0.1.0",
    "@polymarket/time": "^0.1.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
