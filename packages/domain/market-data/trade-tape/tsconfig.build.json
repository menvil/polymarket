{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "paths": {
      "@polymarket/trade": [
        "../../entities/trade/dist/index.d.ts"
      ],
      "@polymarket/trade/*": [
        "../../entities/trade/dist/*"
      ]
    },
    "noEmit": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "__tests__",
    "node_modules",
    "dist"
  ]
}
