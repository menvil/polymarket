{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "types": [
      "jest",
      "@jest/globals",
      "node"
    ],
    "paths": {
      "@polymarket/fill": [
        "../../entities/fill/src/index.ts"
      ],
      "@polymarket/fill/*": [
        "../../entities/fill/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
