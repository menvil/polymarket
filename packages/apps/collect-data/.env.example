# ============================================================
# Polymarket Data Collector — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# No trading credentials required — collector uses public APIs only.

# ============================================================
# General
# ============================================================

NODE_ENV=development
LOG_LEVEL=INFO

# ============================================================
# DNS Override (for machines with blocked/tampered DNS)
# ============================================================

# Set to true if your ISP blocks polymarket.com DNS resolution.
# Uses Cloudflare DoH (1.1.1.1) to bypass provider DNS interception.
# On servers with normal DNS — leave false, no effect on behaviour.
DNS_OVERRIDE_ENABLED=false

# ============================================================
# Polymarket API Endpoints
# ============================================================

# Gamma API — market discovery (public REST)
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com

# Polymarket WebSocket — market data feed (public)
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# WS reconnect delay (ms)
WS_RECONNECT_DELAY_MS=3000

# ============================================================
# Market Discovery & Filtering
# ============================================================

# Minimum hours until market expiry (0 = any market)
MARKET_DISCOVERY_MIN_TIME_TO_EXPIRY_HOURS=0

# Minimum bid-ask spread to include a market (0.0–1.0)
# Example: 0.02 = require at least 2% spread
MARKET_DISCOVERY_MIN_SPREAD=0.02

# Minimum liquidity (USD) to include a market
MARKET_DISCOVERY_MIN_DAILY_VOLUME=100

# Maximum number of markets to track simultaneously
DATA_COLLECTION_MAX_MARKETS=10

# Required keywords — ALL must appear in market question (comma-separated, case-insensitive)
# Leave empty to disable: MARKET_DISCOVERY_REQUIRED_KEYWORDS=
MARKET_DISCOVERY_REQUIRED_KEYWORDS=up,down

# Any-of keywords — AT LEAST ONE must appear in market question (comma-separated, case-insensitive)
# Leave empty to disable: MARKET_DISCOVERY_ANY_OF_KEYWORDS=
MARKET_DISCOVERY_ANY_OF_KEYWORDS=bitcoin,ethereum,solana,xrp

# Excluded keywords — NONE must appear in market question (comma-separated, case-insensitive)
# Leave empty to disable: MARKET_DISCOVERY_EXCLUDED_KEYWORDS=
MARKET_DISCOVERY_EXCLUDED_KEYWORDS=

# How often to rescan for new markets (ms)
MARKET_SCAN_PAUSE_MS=30000

# ============================================================
# Data Collection
# ============================================================

# Output directory for snapshot files
# Structure: OUTPUT_DIR/YYYY-MM-DD/{question}___{marketId}.jsonl[.gz]
DATA_COLLECTION_OUTPUT_DIR=./snapshots

# Compression applied when market expires
# Options: none | gzip
DATA_COLLECTION_COMPRESSION=none

# Number of events to buffer before writing to disk
DATA_COLLECTION_BUFFER_SIZE=100

# Max time between flushes (ms)
DATA_COLLECTION_FLUSH_INTERVAL_MS=10000
