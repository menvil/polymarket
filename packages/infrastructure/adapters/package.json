{
  "name": "@polymarket/adapters",
  "version": "0.1.0",
  "description": "Infrastructure adapters for external services (Pino, etc.)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:tests": "eslint __tests__ --ext .ts",
    "lint:tests:fix": "eslint __tests__ --ext .ts --fix",
    "lint:all": "eslint src __tests__ --ext .ts",
    "lint:all:fix": "eslint src __tests__ --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.lint.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "adapter",
    "infrastructure",
    "pino",
    "logger",
    "polymarket"
  ],
  "author": "Ivan Moroz",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^10.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@polymarket/logger": "^0.1.0",
    "@polymarket/time": "^0.1.0",
    "pino": "^8.17.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
