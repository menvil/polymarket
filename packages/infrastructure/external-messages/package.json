{
  "name": "@polymarket/external-messages",
  "version": "0.1.0",
  "description": "External message boundary contract - source-native observations on the canonical message envelope",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "npm run typecheck:tests && jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "lint:tests": "eslint __tests__ --ext .ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.lint.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "ci": "npm run typecheck:all && npm test",
    "lint:md": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc \"README.md\"",
    "lint:md:fix": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc --fix \"README.md\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "external-message",
    "envelope",
    "boundary",
    "source-native",
    "infrastructure",
    "polymarket"
  ],
  "author": "Ivan Moroz",
  "license": "UNLICENSED",
  "dependencies": {
    "@polymarket/messages": "0.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
