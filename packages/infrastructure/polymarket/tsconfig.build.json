{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "catalog/**/*",
    "rest/**/*",
    "ws/**/*",
    "errors/**/*",
    "events/**/*",
    "projectors/**/*",
    "sdk/**/*",
    "stubs/**/*",
    "adapters/**/*",
    "ports/**/*",
    "dns/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../foundation/logger/tsconfig.build.json"
    },
    {
      "path": "../../foundation/ids/tsconfig.build.json"
    },
    {
      "path": "../../foundation/result/tsconfig.build.json"
    },
    {
      "path": "../../foundation/errors/tsconfig.build.json"
    },
    {
      "path": "../../domain/value-objects/tsconfig.build.json"
    },
    {
      "path": "../../domain/market-data/order-book/tsconfig.build.json"
    },
    {
      "path": "../../domain/entities/trade/tsconfig.build.json"
    },
    {
      "path": "../../application/ports/tsconfig.build.json"
    },
    {
      "path": "../../application/handlers/tsconfig.build.json"
    },
    {
      "path": "../../application/market-discovery/tsconfig.build.json"
    }
  ]
}
