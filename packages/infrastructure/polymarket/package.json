    "@polymarket/result":        "workspace:*",
    "@polymarket/errors":        "workspace:*",
    "@polymarket/value-objects": "workspace:*",
    "@polymarket/order-book":    "workspace:*",
    "@polymarket/trade":         "workspace:*",
