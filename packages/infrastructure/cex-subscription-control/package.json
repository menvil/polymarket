{
  "name": "@polymarket/cex-subscription-control",
  "version": "0.1.0",
  "description": "Shared CEX subscription control: owner demands over aggregated physical CexSource generations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "npm run typecheck:tests && jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:tests": "eslint __tests__ scripts --ext .ts",
    "lint:all": "eslint src __tests__ scripts --ext .ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.lint.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "lint:md": "markdownlint-cli2 --config ../../../.markdownlint-cli2.jsonc \"docs/*.md\"",
    "smoke": "tsx scripts/cex-subscription-control-smoke.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "cex",
    "subscription",
    "claims",
    "pool",
    "ccxt",
    "infrastructure"
  ],
  "author": "Ivan Moroz",
  "license": "UNLICENSED",
  "dependencies": {
    "@polymarket/cex-v2": "0.1.0",
    "@polymarket/errors": "0.1.0",
    "@polymarket/logger": "0.1.0",
    "@polymarket/policy": "0.1.0",
    "@polymarket/timestamp": "0.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@polymarket/external-message-bus": "0.1.0",
    "@polymarket/message-bus": "0.1.0",
    "@polymarket/messages": "0.1.0",
    "@polymarket/result": "^0.1.0",
    "@polymarket/time": "0.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
