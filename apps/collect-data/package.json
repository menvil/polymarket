{
  "name": "@polymarket/collect-data",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --max-old-space-size=4096 --env-file=.env dist/main.js",
    "predev": "find ../.. -not -path '*/dist/*' -not -path '*/node_modules/*' -not -path '*/stubs/ethers*' \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) | grep -v '\\.config\\.' | xargs rm -f 2>/dev/null; true",
    "dev": "npx tsx --env-file=.env src/main.ts",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "check:snapshot": "node --disable-warning=ExperimentalWarning src/checkCexSnapshot.ts",
    "backfill:polymarket": "node --import tsx --env-file=.env src/backfillPolymarketMeta.ts",
    "analyze:chainlink": "node --disable-warning=ExperimentalWarning src/analyzeChainlinkLeadLag.ts",
    "fit:chainlink": "node --disable-warning=ExperimentalWarning src/fitChainlinkLinearModels.ts",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest"
  },
  "dependencies": {
    "@polymarket/cex-subscription-control": "0.1.0",
    "@polymarket/cex-v2": "0.1.0",
    "@polymarket/client": "^0.6.0",
    "@polymarket/collector": "0.1.0",
    "@polymarket/data-collection": "0.1.0",
    "@polymarket/dns-override": "0.1.0",
    "@polymarket/external-message-bus": "0.1.0",
    "@polymarket/external-message-recorder": "0.1.0",
    "@polymarket/ids": "0.1.0",
    "@polymarket/logger": "0.1.0",
    "@polymarket/market": "0.1.0",
    "@polymarket/market-discovery": "0.1.0",
    "@polymarket/market-finalizer": "0.1.0",
    "@polymarket/messages": "0.1.0",
    "@polymarket/message-bus": "0.1.0",
    "@polymarket/policy": "0.1.0",
    "@polymarket/polymarket-control-runtime": "0.1.0",
    "@polymarket/polymarket-subscription-control": "0.1.0",
    "@polymarket/polymarket-v2": "0.1.0",
    "@polymarket/ports": "0.1.0",
    "@polymarket/result": "^0.1.0",
    "@polymarket/subscription-planning": "0.1.0",
    "@polymarket/time": "0.1.0",
    "@polymarket/timestamp": "0.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@polymarket/raw-archive-format": "0.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  }
}
