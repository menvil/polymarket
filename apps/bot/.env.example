# ============================================================
# Polymarket Trading Bot — Environment Configuration
# ============================================================
# Скопируйте в .env и заполните нужные значения.
# ENV-переменные имеют приоритет над JSON-конфигом (ENV > JSON).

# ============================================================
# Live Trading Credentials (REQUIRED for MODE=live)
# ============================================================

# Приватный ключ кошелька (hex, с 0x)
PRIVATE_KEY=0xyour_private_key_here

# Адрес фандера (для POLY_PROXY кошельков; если совпадает с owner — можно не указывать)
FUNDER_ADDRESS=0xyour_funder_address_here

# Polymarket L2 API credentials
# Получить на: https://polymarket.com → Account → API Keys
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_api_passphrase_here

# Builder code для атрибуции ордеров (CLOB V2, обязательно для билдеров)
# Получить на: https://polymarket.com → Builder Profile
# Формат: bytes32 hex-строка (0x + 64 символа)
BUILDER_CODE=0x2035099b0edacd0717f653f7c81078ef9e2b301f858e45cbb02c46377d001300

# ============================================================
# Bot Runtime
# ============================================================

# Режим работы (обязательно): live | paper | backtest
MODE=paper

# Путь к JSON-конфигу (по умолчанию ./config.json)
# CONFIG=configs/dumb-paper-discovery.json

# Переопределение стратегии из JSON-конфига (опционально)
# STRATEGY=dumb

# ============================================================
# Market Discovery & Filtering
# ============================================================
# Применяется только при market.source=discovery.
# Если переменная задана — переопределяет значение из JSON-конфига.
# Если переменная пустая или не задана — используется значение из JSON.

# Required keywords — ALL must appear in market question (comma-separated, case-insensitive)
# Leave empty to disable: MARKET_DISCOVERY_REQUIRED_KEYWORDS=
MARKET_DISCOVERY_REQUIRED_KEYWORDS=up,down

# Any-of keywords — AT LEAST ONE must appear in market question (comma-separated, case-insensitive)
# Leave empty to disable: MARKET_DISCOVERY_ANY_OF_KEYWORDS=
MARKET_DISCOVERY_ANY_OF_KEYWORDS=bitcoin,ethereum,solana,xrp

# Excluded keywords — NONE must appear in market question (comma-separated, case-insensitive)
# Leave empty to disable: MARKET_DISCOVERY_EXCLUDED_KEYWORDS=
MARKET_DISCOVERY_EXCLUDED_KEYWORDS=

# Minimum liquidity (USD) to include a market
MARKET_DISCOVERY_MIN_LIQUIDITY=500

# Minimum hours until market expiry (0 = any market)
MARKET_DISCOVERY_MIN_TIME_TO_EXPIRY_HOURS=2
