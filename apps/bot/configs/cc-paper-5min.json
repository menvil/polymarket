{
  "strategy": "calibrated-crowd",
  "strategyParams": {
    "edgeTablePath": "tables/edge-table-5min.json",
    "minComposite": 0.3,
    "maxPositionFraction": 0.05,
    "maxSharesPerMarket": 5,
    "warmupSec": 15,
    "regimeThresholdPerMin": 10,
    "regimeWindowMs": 60000,
    "regimeMinPoints": 5,
    "exitOnRegimeFlip": false,
    "exitOnWeightDrop": false,
    "exitOnTauTimeout": false,
    "exitOnEdgeClosure": false,
    "allowPanicTaker": false
  },
  "execution": {
    "postOnly": true
  },
  "market": {
    "source": "discovery",
    "filter": {
      "requiredKeywords": ["bitcoin", "up or down"],
      "minDurationMinutes": 4,
      "maxDurationMinutes": 6
    },
    "scanPauseMs": 30000,
    "outcomeIndex": 0
  },
  "resources": {
    "initialBalance": 100,
    "maxConcurrentMarkets": 1,
    "minCapitalPerMarket": 1,
    "tradingBalanceRatio": 1.0
  },
  "paper": {
    "fillOnBookCrossing": true,
    "fillOnTape": true,
    "fillAtOrderPrice": true
  },
  "account": {
    "accountId": "venue:POLYMARKET:paper-account"
  },
  "recording": {
    "enabled": false,
    "outputDir": "./data/paper-recordings",
    "journalDir": "./data/paper-journals",
    "compression": "gzip"
  }
}
