{
  "strategyRules": [
    {
      "label": "5min-selective",
      "match": { "minDurationMinutes": 4, "maxDurationMinutes": 6 },
      "strategy": "selective-entry",
      "strategyParams": {
        "orderSize": 5,
        "minZoneCents": 55,
        "maxZoneCents": 60,
        "minDeltaPct": 0.03,
        "maxDeltaPct": 0.12,
        "minTauSec": 120,
        "maxTauSec": 210,
        "maxSpreadCents": 4,
        "warmupSec": 60,
        "bidOffsetCents": 1,
        "side": "up"
      }
    },
    {
      "label": "15min-adaptive",
      "match": { "minDurationMinutes": 14, "maxDurationMinutes": 16 },
      "strategy": "adaptive-entry",
      "strategyParams": {
        "orderSize": 5,
        "waitPct": 0.5,
        "minEwmaCents": 50,
        "minRiseCents": 5,
        "warmupTrades": 10,
        "bidOffsetCents": 1
      }
    }
  ],
  "market": {
    "source": "discovery",
    "filter": {
      "anyOfKeywords": ["bitcoin", "BTC"],
      "minLiquidity": 500,
      "minDurationMinutes": 4,
      "maxDurationMinutes": 16
    },
    "scanPauseMs": 60000,
    "outcomeIndex": 0,
    "bidirectional": true
  },
  "resources": {
    "initialBalance": 100,
    "maxConcurrentMarkets": 6,
    "minCapitalPerMarket": 10,
    "tradingBalanceRatio": 1.0
  },
  "paper": {
    "fillOnBookCrossing": true,
    "fillOnTape": true,
    "fillAtOrderPrice": true
  },
  "account": {
    "accountId": "venue:POLYMARKET:paper-account"
  }
}
