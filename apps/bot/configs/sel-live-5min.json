{
  "strategy": "selective-entry",
  "strategyParams": {
    "orderSize": 5,
    "minZoneCents": 55,
    "maxZoneCents": 68,
    "minDeltaPct": 0.03,
    "maxDeltaPct": 0.12,
    "minTauSec": 60,
    "maxTauSec": 210,
    "maxSpreadCents": 4,
    "warmupSec": 60,
    "bidOffsetCents": 1,
    "requireDeltaAccel": true
  },
  "market": {
