  },
  "resources": {
    "initialBalance": 100,
    "maxConcurrentMarkets": 1,
    "minCapitalPerMarket": 1,
    "tradingBalanceRatio": 1.0
  },
  "account": {
    "accountId": "venue:POLYMARKET:live"
  },
  "recording": {
    "enabled": true,
    "outputDir": "./data/live-recordings",
    "journalDir": "./data/live-journals",
    "compression": "gzip"
  }
}
