{
  "strategy": "cross-market-arb",
  "strategyParams": {
    "peerInstrumentId": "placeholder",
    "minSpreadAfterFees": 0.005,
    "maxPositionUnits": 50
  },
  "market": {
    "source": "discovery",
    "filter": {
