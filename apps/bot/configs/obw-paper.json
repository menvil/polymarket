{
  "market": {
    "source": "discovery",
    "filter": {
      "anyOfKeywords": ["BTC", "ETH", "Bitcoin", "Ethereum"],
      "minTimeToExpiryHours": 0.05,
      "maxDurationMinutes": 10
    },
    "scanPauseMs": 5000,
    "outcomeIndex": 0,
    "bidirectional": true
  },
  "strategyParams": {
    "side": "up",
    "orderSize": 5,
    "venue": "binance",
    "lookbackMs": 60000,
    "bandSizePct": 0.002,
    "wallThresholdFactor": 3.0,
    "minWallSize": 100000,
    "minWallAgeMs": 5000,
    "consumptionWindowMs": 30000,
    "absorptionThreshold": 0.6,
    "minSignalStrength": 0.4,
    "minEdgeCents": 1.5,
    "holdMaxMs": 180000,
    "stopLossCents": 5,
    "sigmaAnnual": 0.6
  },
  "resources": {
    "initialBalance": 200,
    "maxConcurrentMarkets": 2,
    "minCapitalPerMarket": 10,
    "tradingBalanceRatio": 1.0
  }
}
