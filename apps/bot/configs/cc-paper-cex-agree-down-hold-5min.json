{
  "strategy": "calibrated-crowd-cex",
  "strategyParams": {
    "edgeTablePath": "tables/edge-table-5min.json",
    "crowdGate": "relaxed",
    "relaxedEntrySide": "down",
    "relaxedMinN": 20,
    "relaxedMinEdge": 0.01,
    "relaxedMinCiEdge": -1,
    "relaxedRequireOos": false,
    "minComposite": 0.05,
    "orderShares": 5,
    "warmupSec": 15,
    "regimeThresholdPerMin": 10,
    "regimeWindowMs": 60000,
    "regimeMinPoints": 5,
    "exitOnRegimeFlip": false,
    "exitOnWeightDrop": false,
    "exitOnTauTimeout": false,
    "exitOnEdgeClosure": false,
    "allowPanicTaker": false,
    "logEntries": true,
    "cexFilterMode": "agree",
    "cexSignalId": "cex_chainlink_linear_lead_lag",
    "cexVenues": ["binance", "coinbase", "okx"],
    "cexThresholdBps": 0.5,
    "cexStaleMs": 2000,
    "cexMinVenueCount": 3,
    "cexMaxSpreadBps": 10,
    "cexLinearInterceptUsd": 0.287371,
    "cexWeights": {
      "binance": 0.058008,
      "coinbase": 0.082893,
      "okx": 0.07737
    },
    "cexBasisByVenue": {
      "binance": -24.734,
      "coinbase": 1.416,
      "okx": -6.844
    }
  },
  "execution": {
    "postOnly": true
  },
  "market": {
    "source": "discovery",
    "filter": {
      "requiredKeywords": ["bitcoin", "up or down"],
      "minDurationMinutes": 4,
      "maxDurationMinutes": 6
    },
    "scanPauseMs": 30000,
    "outcomeIndex": 0
  },
  "resources": {
    "initialBalance": 100,
    "maxConcurrentMarkets": 1,
    "minCapitalPerMarket": 1,
    "tradingBalanceRatio": 1.0
  },
  "paper": {
    "fillOnBookCrossing": true,
    "fillOnTape": true,
    "fillAtOrderPrice": true
  },
  "account": {
    "accountId": "venue:POLYMARKET:paper-account"
  },
  "recording": {
    "enabled": true,
    "outputDir": "./data/paper-recordings",
    "journalDir": "./data/paper-journals",
    "compression": "gzip"
  },
  "cex": {
    "enabled": true,
    "outputDir": "./data/paper-recordings/cex",
    "compression": "gzip",
    "windowMinutes": 5,
    "bufferSize": 200,
    "flushIntervalMs": 5000,
    "exchanges": {
      "binance": {
        "type": "spot",
        "symbols": ["BTC/USD"],
        "orderbook": true,
        "trades": true,
        "obDepth": 10,
        "obMethod": "watch"
      },
      "coinbase": {
        "type": "spot",
        "symbols": ["BTC/USD"],
        "orderbook": true,
        "trades": true,
        "obDepth": 10,
        "obMethod": "watch"
      },
      "okx": {
        "type": "spot",
        "symbols": ["BTC/USD"],
        "orderbook": true,
        "trades": true,
        "obDepth": 10,
        "obMethod": "watch"
      }
    }
  }
}
