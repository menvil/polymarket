# ── Обязательно ──────────────────────────────────────────────────────────────
# Адрес кошелька, по которому строится отчёт. Это публичный адрес блокчейна,
# не секрет. Позиции и активность по нему читаются без аутентификации.
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ── Опционально: комиссии и роль MAKER/TAKER ─────────────────────────────────
# Ставка комиссии (feeRateBps) видна только своему аккаунту. Задайте все
# четыре переменные, чтобы отчёт пошёл аутентифицированным путём; без них
# колонка FEES печатает «—», а всё остальное считается как обычно.
#
# PRIVATE_KEY=0x…
# POLYMARKET_API_KEY=…
# POLYMARKET_API_SECRET=…
# POLYMARKET_API_PASSPHRASE=…
