{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../../packages/foundation/logger/tsconfig.build.json"
    },
    {
      "path": "../../packages/foundation/time/tsconfig.build.json"
    },
    {
      "path": "../../packages/domain/entities/fill/tsconfig.build.json"
    },
    {
      "path": "../../packages/infrastructure/polymarket/tsconfig.build.json"
    }
  ]
}
