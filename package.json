{
  "name": "@polymarket/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Polymarket trading system monorepo",
  "workspaces": [
    "packages/foundation/*",
    "packages/domain/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "rm -rf node_modules packages/*/*/node_modules packages/*/*/dist"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymarket/trading-system.git"
  },
  "keywords": [
    "polymarket",
    "trading",
    "monorepo",
    "typescript"
  ],
  "author": "Ivan Moroz",
  "license": "MIT"
}
