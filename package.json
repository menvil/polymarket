{
  "name": "polymarket-mm-bot",
  "version": "4.0.0",
  "description": "Production-ready Market Making Bot for Polymarket with DDD architecture",
  "type": "module",
  "main": "dist/bootstrap/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/bootstrap/main.ts",
    "dev:inspect": "tsx watch --inspect --clear-screen=false src/bootstrap/main.ts",
    "build": "tsc -p configs/tsconfig.build.json",
    "start": "node dist/bootstrap/main.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "clean": "rm -rf dist coverage",
    "docs:generate": "typedoc",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "polymarket",
    "market-making",
    "trading-bot",
    "ddd",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "@ethersproject/providers": "^5.7.2",
    "@ethersproject/wallet": "^5.7.0",
    "@polymarket/clob-client": "^5.1.3",
    "@polymarket/order-utils": "^3.0.1",
    "apache-arrow": "^21.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "neo-blessed": "^0.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
